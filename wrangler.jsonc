{
  "name": "warhol-ar",
  "main": "src/worker.js",
  "account_id": "8495105da2e87ddfc949b06db0689ab3", // Cyan (owns scian.xyz)
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "warhol-ar", "database_id": "791d6c85-73a2-40a8-884d-9495c8a0c042" }
  ],
  "routes": [{ "pattern": "warhol-ar.scian.xyz", "custom_domain": true }]
  // ADMIN_KEY: `wrangler secret put ADMIN_KEY` (prod) / .dev.vars (local)
}
